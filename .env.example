# ── Devora Bot — Environment Variables ──────────────────────────────────────
# Copy this file to ".env" (same folder as devora_bot.py) and fill in the values.

# Monday.com API Key
# Get it from: monday.com → Profile pic → Admin → API → Copy personal API token
MONDAY_API_KEY=your_monday_api_key_here

# WhatsApp bridge — the free Auto Replier Node app (server.js) that holds your
# WhatsApp session. Leave as-is unless you run it on a different host/port.
WA_BRIDGE_URL=http://127.0.0.1:3000

# Your WhatsApp number (shown in Message #3 as a callback CTA)
# Format: country code + number, no + or spaces. Example for Pakistan: 923001234567
YOUR_WHATSAPP_NUMBER=923001234567

# ── Optional: throttling / anti-ban safety (defaults shown) ──────────────────
# These have sensible defaults — only add them if you want to change them.

# Max messages sent per day (keeps you under WhatsApp's spam radar)
DAILY_CAP=25

# Random gap between messages, in seconds (looks human, not botty)
MIN_DELAY_SEC=30
MAX_DELAY_SEC=90

# Only send between these hours (24h clock). Reply-checking still runs anytime.
SEND_START_HOUR=9
SEND_END_HOUR=21
